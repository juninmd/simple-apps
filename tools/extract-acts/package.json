{
  "name": "extract-acts",
  "version": "0.1.0",
  "description": "Turn meeting transcripts into checkable task lists without leaving the terminal.",
  "type": "module",
  "bin": {
    "extract-acts": "./bin/extract-acts.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["bin", "dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": ["cli", "transcript", "tasks", "export", "jira", "asana", "github"],
  "author": "Antonio Carlos <jr_acn@hotmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
