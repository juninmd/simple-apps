# Gateway OpenAI-compatible: LiteLLM, vLLM, Ollama, Groq, OpenRouter...
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=

# vazio = pergunta ao gateway quais modelos existem
LLM_MODELS=
LLM_SKIP_MODELS=

LLM_REPEATS=2
LLM_CONCURRENCY=2
LLM_TIMEOUT_MS=60000
# suba para modelos de raciocínio, que gastam o orçamento pensando
LLM_MAX_TOKENS=200

DB_PATH=./data/bench.db

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
