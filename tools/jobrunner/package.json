{
  "name": "jobrunner",
  "version": "1.0.0",
  "description": "Cron-as-a-service: fire scheduled HTTP requests, keep run history, alert on failure. Replaces scattered k8s CronJobs.",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test"
  },
  "keywords": ["cron", "scheduler", "http", "jobs", "bun", "hono"],
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
