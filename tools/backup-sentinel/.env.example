# Catálogo de alvos (ver targets.example.json)
TARGETS_FILE=./targets.json
# Onde os snapshots ficam. Aponte para um volume FORA do cluster.
BACKUP_DIR=./data/backups
# Snapshots mantidos por alvo
KEEP=7
# Contexto do kubeconfig (vazio = o atual)
KUBE_CONTEXT=

# Falha o processo (exit 2) quando qualquer alvo não fica "ok"
STRICT=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
